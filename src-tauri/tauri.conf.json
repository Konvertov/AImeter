{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Meter",
  "version": "0.3.8",
  "identifier": "dev.aimeter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Meter",
        "width": 360,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQjc1RUIwMzNGOTVEODMKUldTRFhma3pzRjYzUUZpWFRJM2NUTmUzRy9mM3RTcXhjZGxNOWllUDdiSnN5c3U4V2dhb0tJdlAK",
      "endpoints": [
        "https://github.com/Konvertov/ai-meter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
